# Server only. Never place this key in browser configuration.
OPENAI_API_KEY=
DEMO_MODE=true
OPENAI_MODEL=gpt-6-luna
OPENAI_API_ENABLED=false
OPENAI_ANALYSIS_INTERVAL_SECONDS=60
OPENAI_MAX_MESSAGES_PER_BATCH=100
OPENAI_MAX_INPUT_CHARS=8000
OPENAI_MAX_OUTPUT_TOKENS=250
# 0 disables the hourly call cap for testing. Daily budget/concurrency still apply.
OPENAI_MAX_CALLS_PER_HOUR=20
# false disables daily budget enforcement for testing; usage/cost accounting stays active.
OPENAI_DAILY_BUDGET_ENABLED=true
OPENAI_DAILY_BUDGET_USD=0.10
OPENAI_REASONING_EFFORT=none

# Native startup binds to 127.0.0.1. Compose overrides this to container mode.
APP_NETWORK_MODE=local
PORT=3000
# Channel login (without #) or https://www.twitch.tv/your_channel. Used when DEMO_MODE=false.
TWITCH_CHANNEL=
# Server-side Twitch app credentials for the optional ten-minute screenshot jokes.
# Register a Confidential app, then generate a Client Secret. Never expose these to the browser.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional comma-separated local block list.
BLOCKED_TERMS=

# Conservative estimates per 1,000,000 tokens, NOT published model rates.
# Set both to the actual price for your selected model before enabling AI.
OPENAI_INPUT_PRICE_PER_MILLION=1.00
OPENAI_OUTPUT_PRICE_PER_MILLION=5.00
OPENAI_TIMEOUT_MS=15000
# Legacy/demo analyzer option. Live minute sentiment sends bounded, safe chat text.
OPENAI_INCLUDE_REPRESENTATIVES=false

# Live sentiment: one 60s batch; one viewer and five accepted comments qualify.
CHAT_PULSE_MIN_MESSAGES=5
CHAT_PULSE_MIN_USERS=1
# Cooldown/dominance below apply to the labelled local demo, not live AI results.
CHAT_PULSE_COOLDOWN_SECONDS=30
CHAT_PULSE_DOMINANCE=0.4
